# Copy to .env (or set in your host's environment). Never commit real values.
PORT=3000
# SQLite file location. Back this file up.
DB_PATH=./data/orby.db
# Timezone (confirm yours) for the 08:00 briefing and evening prep reminders (IANA name).
TZ_NAME=Asia/Kolkata
# Set to "1" only when served over HTTPS (secure cookies).
SECURE_COOKIES=0
